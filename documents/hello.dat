; HELLO - a first program for miniVIC ASM; assemble it with ASM, save it (S), then in MON:;   L HELLO     G 3000VDPDATA = $B000VDPREG  = $B001TEXTPOS = $0800+494          ; VRAM: row 12 (12*40), column 14        .ORG $3000START   LDA #<TEXTPOS        STA VDPREG        LDA #>TEXTPOS        ORA #$40                 ; (write)        STA VDPREG        LDX #0LOOP    LDA MSG,X        BEQ DONE        ORA #$80                 ; in inverse        STA VDPDATA        INX        BNE LOOPDONE    TXA                      ; A = characters written        RTSMSG     .BYTE "HELLO MINIVIC",0